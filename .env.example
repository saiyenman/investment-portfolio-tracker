# ─────────────────────────────────────────────────────────────────────────
# Copier ce fichier en .env.local (déjà couvert par .gitignore) et remplir.
# ─────────────────────────────────────────────────────────────────────────

# Connexion Postgres utilisée par l'application (Drizzle).
# Supabase → Project Settings → Database → Connection string → « Transaction pooler ».
# Remplacer [YOUR-PASSWORD] par le mot de passe de la base.
# Le pooler transactionnel (port 6543) impose prepare:false, déjà géré dans lib/db/index.ts.
DATABASE_URL="postgresql://postgres.<ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Connexion directe (port 5432), utilisée uniquement par drizzle-kit push/migrate.
DIRECT_URL="postgresql://postgres.<ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Valeurs publiques du projet Supabase — destinées au navigateur, non secrètes.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
